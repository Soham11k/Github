# Environment variables for GitHub OSINT Database
# Copy to .env in the project root (or backend/) and fill in values.
#
# LOCAL DEMO ONLY: default ADMIN_TOKEN and DB password below are for coursework.
# Change them before any shared / internet-facing deploy. Never commit a real .env.

DATABASE_URL=postgresql://osint:osint@localhost:5432/github_osint
GITHUB_TOKEN=
ADMIN_TOKEN=changeme
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-repo ingest sample caps (paginated GitHub list fetches)
INGEST_COMMIT_LIMIT=300
INGEST_ISSUE_LIMIT=200
INGEST_PR_LIMIT=100
INGEST_FORK_LIMIT=15
INGEST_PR_DETAIL_LIMIT=20
INGEST_CONTRIBUTOR_LIMIT=100
INGEST_LABELED_ISSUE_LIMIT=50
