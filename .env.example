# RepoPulse environment
# Copy to .env in the project root. Never commit a real .env.

APP_ENV=development
APP_NAME=RepoPulse

DATABASE_URL=postgresql://osint:osint@localhost:5432/github_osint
GITHUB_TOKEN=

# Local demo only — ignored when APP_ENV=production (use ADMIN_GITHUB_LOGINS + OAuth)
ADMIN_TOKEN=changeme
ADMIN_GITHUB_LOGINS=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# GitHub OAuth (optional locally; required for production sign-in)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
SESSION_SECRET=dev-session-secret-change-me
COOKIE_SECURE=false

# Optional error tracking
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_API_BASE=

# Per-repo ingest sample window + caps
INGEST_ACTIVITY_DAYS=180
INGEST_COMMIT_LIMIT=300
INGEST_ISSUE_LIMIT=200
INGEST_PR_LIMIT=100
INGEST_FORK_LIMIT=15
INGEST_PR_DETAIL_LIMIT=20
INGEST_CONTRIBUTOR_LIMIT=100
INGEST_LABELED_ISSUE_LIMIT=50
